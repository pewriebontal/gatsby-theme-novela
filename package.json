{
  "name": "gatsby-theme-novela-workspace",
  "private": true,
  "version": "0.0.1",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "NODE_OPTIONS=--openssl-legacy-provider npm run build --workspace www",
    "clean": "npm run clean --workspace www",
    "dev": "npm run start",
    "lint": "eslint --ignore-path .gitignore .",
    "start": "NODE_OPTIONS='--openssl-legacy-provider --no-deprecation' npm run develop --workspace www",
    "bootstrap": "lerna bootstrap",
    "publish": "lerna version && lerna publish",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execFileSync('husky', { stdio: 'inherit', shell: true })\""
  },
  "workspaces": [
    "@pewriebontal/gatsby-theme-novela",
    "www"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-unicorn": "^10.0.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "postcss": "^8.5.14",
    "prettier": "^2.8.8"
  },
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "plugin:prettier/recommended",
      "plugin:unicorn/recommended"
    ],
    "env": {
      "browser": false
    },
    "overrides": [],
    "plugins": [],
    "rules": {
      "unicorn/no-abusive-eslint-disable": 0,
      "unicorn/prefer-module": 0,
      "unicorn/no-empty-file": 0,
      "unicorn/no-array-callback-reference": 0,
      "unicorn/prefer-includes": 0,
      "unicorn/consistent-function-scoping": 0,
      "no-restricted-syntax": 0,
      "unicorn/filename-case": [
        "error",
        {
          "cases": {
            "camelCase": true,
            "kebabCase": true
          }
        }
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0"
  }
}
